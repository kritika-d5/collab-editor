{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "types": ["node", "react", "react-dom"],
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
